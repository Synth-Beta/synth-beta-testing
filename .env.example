# Synth environment variables — copy to .env.local and fill in real values.
# NEVER commit .env or .env.local (see .gitignore).

# --- Supabase (required) ---
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Anon/publishable key — safe for client bundles (RLS must protect data)
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service role — SERVER/SCRIPTS ONLY; bypasses RLS. Never expose to Vite/Expo.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vite web app (same Supabase project as above)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Expo mobile (must match web project for shared auth/data)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Backend Express (port 3001) ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
# Comma-separated extra CORS origins
ADDITIONAL_CORS_ORIGINS=
# Dev-only mock Apple auth JWT signing (required in production if /auth/apple used)
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d

# --- External APIs ---
JAMBASE_API_KEY=
JAMBASE_API_KEY_OLD=
SETLIST_FM_API_KEY=
TM_API_KEY=
TICKETMASTER_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SETLIST_FM_API_KEY_OLD=

# --- Maps (client — set VITE_ prefix for web) ---
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_KEY=

# --- Apple / push ---
VITE_APPLE_MUSIC_DEVELOPER_TOKEN=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tejpatel.synth
APNS_KEY_PATH=
APNS_KEY_CONTENT=
APNS_PRODUCTION=false
EXPO_ACCESS_TOKEN=

# --- Vercel / cron / webhooks ---
CRON_SECRET=generate-a-long-random-string
BACKEND_URL=http://localhost:3001
PUSH_WEBHOOK_SECRET=generate-a-long-random-string
SUPABASE_AUTH_HOOK_SECRET=generate-a-long-random-string

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site URLs ---
VITE_SITE_URL=https://join.getsynth.app
VITE_PUBLIC_SITE_URL=https://join.getsynth.app
# Spotify OAuth callback — must match Spotify Developer Dashboard redirect URIs
VITE_SPOTIFY_REDIRECT_URI=https://join.getsynth.app/auth/spotify/callback
VITE_BACKEND_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001
SITE_URL=https://join.getsynth.app

# --- Optional auth (Expo Google) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_SITE_URL=https://join.getsynth.app
# Spotify in-app OAuth (must match VITE_SPOTIFY_CLIENT_ID / SPOTIFY_CLIENT_ID)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
