# Example Vite environment variables. Copy to `.env.local` and fill in real values.

# Supabase
VITE_SUPABASE_URL=https://<your-supabase-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Optional local backend override (used during development)
VITE_BACKEND_URL=http://localhost:3001

# Mapbox
VITE_MAPBOX_TOKEN=pk.<your-mapbox-token>

# API host for native builds / production deployments
VITE_API_BASE_URL=https://<your-vercel-domain>

# Development flag
VITE_NODE_ENV=development
