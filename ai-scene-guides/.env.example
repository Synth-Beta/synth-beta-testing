# AI Scene Guides env (placeholders only — never commit secrets)

# Destination mode: fixture | shadow_slack | staff_approve | production
AI_SCENE_GUIDES_MODE=fixture
# Global kill switch (must be true AND DB settings.enabled for any publish)
AI_SCENE_GUIDES_ENABLED=false

# JamBase Data API v3 (server-side only)
JAMBASE_API_KEY=
JAMBASE_USER_AGENT=SynthAISceneGuides/1.0 (getsynth.app; contact=ops@getsynth.app)

# Approved Reddit Data API (aggregate topic signals only)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SynthAISceneGuides/1.0 by Synth

# OpenAI (generation). Fixture mode can run without this using heuristic stub.
OPENAI_API_KEY=
OPENAI_SCENE_GUIDES_MODEL=gpt-4o-mini

# Slack shadow pilot (separate from Synth PM / HubSpot bots)
AI_SHADOW_SLACK_BOT_TOKEN=
AI_SHADOW_SLACK_SIGNING_SECRET=
AI_SHADOW_SLACK_FEED_CHANNEL_ID=
AI_SHADOW_SLACK_ALERTS_CHANNEL_ID=
AI_SHADOW_SLACK_DAILY_CHANNEL_ID=
# Comma-separated Slack user IDs allowed to review / run commands
AI_SHADOW_REVIEWER_ALLOWLIST=

# Optional Supabase (audit persistence; fixture mode works in-memory)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
