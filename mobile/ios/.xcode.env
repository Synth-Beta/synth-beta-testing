# NODE_BINARY for "Bundle React Native code and images".
# ci_post_clone.sh / ci_pre_xcodebuild.sh write .xcode.env.local with an absolute path.
# POSIX sh syntax — this file is sourced by /bin/sh during xcodebuild (-hideShellScriptEnvironment).
if [ -z "${NODE_BINARY:-}" ] || [ ! -x "${NODE_BINARY}" ]; then
  if [ -x /opt/homebrew/bin/node ]; then
    export NODE_BINARY=/opt/homebrew/bin/node
  elif [ -x /usr/local/bin/node ]; then
    export NODE_BINARY=/usr/local/bin/node
  else
    export NODE_BINARY="$(command -v node 2>/dev/null || true)"
  fi
fi
