# Sourced by RN/Expo Xcode build phases after .xcode.env.local.
# Xcode Cloud archive runs with -hideShellScriptEnvironment (empty PATH).
export PATH="/opt/homebrew/bin:/usr/local/bin:${PATH}"
for node_dir in "${HOME}"/.xcode-cloud-node/node-v*-darwin-*/bin; do
  if [ -d "${node_dir}" ]; then
    export PATH="${node_dir}:${PATH}"
  fi
done
# Xcode Cloud sets CI=TRUE; Expo getenv treats non-lowercase as non-boolean and crashes Metro.
export CI=
