# Expo / React Native environment variables.
# Copy to .env or .env.local in this directory and fill in real values.
# Use the same Supabase project as the web app so all clients share one backend.

# Supabase (required for auth and data)
EXPO_PUBLIC_SUPABASE_URL=https://<your-supabase-project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Optional: match root .env.local / .env.example values for the same backend.
