{
  "expo": {
    "name": "Synth",
    "slug": "synth",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "synth",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF2F8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tejpatel.synth",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tejpatel.synth",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#CC2486",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#CC2486",
      "backgroundColor": "#FCFCFC"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Synth uses photos you choose to attach to your concert reviews.",
          "cameraPermission": "Synth uses your camera to take photos for chat messages."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#CC2486",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e937d91-e417-40f3-9491-802ec01052c2"
      }
    }
  }
}
