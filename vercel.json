{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/spotify/callback",
      "destination": "/"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/share",
      "destination": "/api/share"
    },
    {
      "source": "/share/",
      "destination": "/api/share"
    },
    {
      "source": "/((?!assets/|\\.well-known/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/share.ts": {
      "maxDuration": 10
    },
    "api/setlists/search.ts": {
      "maxDuration": 10
    },
    "api/push-notification-webhook.ts": {
      "maxDuration": 15
    },
    "api/slack-pm/commands.ts": {
      "maxDuration": 30
    },
    "api/slack-pm/interactions.ts": {
      "maxDuration": 60
    },
    "api/cron/sync-events.ts": {
      "maxDuration": 10
    },
    "api/cron/seed-bot-messages.ts": {
      "maxDuration": 10
    },
    "api/cron/slack-pm-digest.ts": {
      "maxDuration": 60
    },
    "api/spotify/sync-profile.ts": {
      "maxDuration": 30
    },
    "api/slack-signup-webhook.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-events",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron/seed-bot-messages",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/slack-pm-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/slack-pm-digest",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/slack-pm-digest",
      "schedule": "0 21 * * *"
    }
  ]
}
