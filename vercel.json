{
  "installCommand": "npm install --include=dev && npm install --prefix apps/admin && npm install --prefix ai-scene-guides --omit=dev",
  "buildCommand": "node scripts/build-vercel-production.mjs",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ops-alert",
      "destination": "/api/ai-scene-guides?job=ops-alert"
    },
    {
      "source": "/api/cron/ai-scene-guides-schedule",
      "destination": "/api/ai-scene-guides?job=schedule"
    },
    {
      "source": "/api/cron/ai-scene-guides-publish",
      "destination": "/api/ai-scene-guides?job=publish"
    },
    {
      "source": "/api/cron/ai-scene-guides-shadow",
      "destination": "/api/ai-scene-guides?job=shadow"
    },
    {
      "source": "/api/admin/ai-scene-guides-cron",
      "destination": "/api/ai-scene-guides?job=admin"
    },
    {
      "source": "/api/admin/ai-scene-guides-quality-seed",
      "destination": "/api/ai-scene-guides?job=quality-seed"
    },
    {
      "source": "/api/slack/scene-guides/commands",
      "destination": "/api/ai-scene-guides?job=slack-commands"
    },
    {
      "source": "/api/slack/scene-guides/events",
      "destination": "/api/ai-scene-guides?job=slack-events"
    },
    {
      "source": "/api/slack/scene-guides/interactions",
      "destination": "/api/ai-scene-guides?job=slack-interactions"
    },
    {
      "source": "/api/auth/bridge-session",
      "destination": "/api/auth/session?job=bridge"
    },
    {
      "source": "/api/auth/redeem-session",
      "destination": "/api/auth/session?job=redeem"
    },
    {
      "source": "/api/cron/sync-events",
      "destination": "/api/cron?job=sync-events"
    },
    {
      "source": "/api/cron/seed-bot-messages",
      "destination": "/api/cron?job=seed-bot-messages"
    },
    {
      "source": "/api/cron/slack-pm-digest",
      "destination": "/api/cron?job=slack-pm-digest"
    },
    {
      "source": "/auth/spotify/callback",
      "destination": "/"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/share",
      "destination": "/api/share"
    },
    {
      "source": "/share/",
      "destination": "/api/share"
    },
    {
      "source": "/((?!assets/|\\.well-known/|api/|_site/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/share.ts": {
      "maxDuration": 10
    },
    "api/setlists/search.ts": {
      "maxDuration": 10
    },
    "api/push-notification-webhook.ts": {
      "maxDuration": 15
    },
    "api/slack-signup-webhook.ts": {
      "maxDuration": 10
    },
    "api/slack-pm/commands.ts": {
      "maxDuration": 30
    },
    "api/slack-pm/interactions.ts": {
      "maxDuration": 60
    },
    "api/cron/index.ts": {
      "maxDuration": 60
    },
    "api/auth/session.ts": {
      "maxDuration": 10
    },
    "api/ai-scene-guides.ts": {
      "maxDuration": 120
    },
    "api/spotify/sync-profile.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron?job=sync-events",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron?job=seed-bot-messages",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/ai-scene-guides",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/ai-scene-guides",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/ai-scene-guides",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/ai-scene-guides",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/ai-scene-guides",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/ai-scene-guides",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/ai-scene-guides",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron?job=slack-pm-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron?job=slack-pm-digest",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron?job=slack-pm-digest",
      "schedule": "0 21 * * *"
    }
  ]
}
