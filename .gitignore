# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode / Cursor
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.cursor/

# Legacy Capacitor iOS project (app uses Expo mobile/ now)
ios/
capacitor.config.json
synth-native-ios/.swiftpm/

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Environment files — NEVER commit (contain API keys and secrets)
.env
.env.local
.env.*.local
.env.vercel
.env.vercel.*
*.env
apps/admin/.env.local

# Apple Push Notification key — NEVER commit (private key)
*.p8
backend/secure/
scripts/sync-checkpoint.json
scripts/genre-enrich-checkpoint.json

# AI agent skill source (installed via `npx skills add`). .claude/skills/ is
# the committed copy this repo actually uses; .agents/ is just the local
# symlink source for other tools and duplicates the same content on Windows
# (core.symlinks=false flattens symlinks into real file copies, so keeping
# both tracked would duplicate every file).
.agents/
.vercel
deep-research-skills/

# graphify build cache — pure derived/regeneratable AST extraction cache,
# not a shareable deliverable (unlike graph.json/GRAPH_REPORT.md). Churns on
# every rebuild if tracked, adding noise to unrelated commits.
graphify-out/cache/
# graphify's own dated auto-backup ("backed up curated graph -> YYYY-MM-DD/")
# taken before each hook-triggered rebuild — git history already covers this.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Sentry Config File
.env.sentry-build-plugin

# Local sync run output - regenerated every run, never worth committing
logs/
